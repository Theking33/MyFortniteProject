    OnPackagingPressed(InAgent : agent)<suspends>:void=
        if (InPlayer := player[InAgent]):
            var WasUsedForEvent : logic = false

            # --- [1. حسابات مستويات التطوير] ---
            var BasePackTime : float = 4.0 

            if (Stats := SavedPlayerData[InPlayer]):
                LevelAsFloat := IntToFloat(Stats.SavedPackLevel)
                Reduction := LevelAsFloat * 0.5
                set BasePackTime = if (BasePackTime - Reduction < 1.0) then 1.0 else BasePackTime - Reduction
                
                # 🟢 التعديل هنا: نستخدم set فقط لأن المتغير موجود مسبقاً في الكلاس
                set BonusDeliveryTime = LevelAsFloat * 20.0

            # الوقت الإجمالي الذي سيُعطى للاعب
            TotalTimeForDelivery := 120.0 + BonusDeliveryTime

            # --- [2. كود الأحداث الكبرى - Event] ---
            if (IsEventActive?):
                for (Key -> Req : ActiveEventReqs):
                    var IsColdFood : logic = false
                    for (MenuItem : FoodMenu):
                        if (MenuItem.FoodName = Req.FoodName and MenuItem.NeedsCooking = false):
                            set IsColdFood = true

                    if (Req.IsFullyPacked = false):
                        if (Req.IsCookedCount >= Req.RequiredAmount or (IsColdFood? and Req.CurrentBatchCount >= Req.RequiredAmount)):
                            NewReq := event_requirement{
                                FoodName := Req.FoodName,
                                RequiredAmount := Req.RequiredAmount,
                                CurrentBatchCount := Req.RequiredAmount,
                                IsCookedCount := Req.RequiredAmount, 
                                IsFullyPacked := true 
                            }

                            if (set ActiveEventReqs[Key] = NewReq):
                                set WasUsedForEvent = true
                                for (i := 1..Req.RequiredAmount):
                                    ItemRemover.Remove(InAgent) 
                                
                                EventBoxGranter.GrantItem(InAgent) 
                                HUDMessage.SetText(TextToMsg("✅ تم تغليف {Req.FoodName}!"))
                                HUDMessage.Show(InPlayer)
                                UpdateUI(InPlayer)

                if (WasUsedForEvent?):
                    CheckEventStageTransition(InPlayer)

            # --- [3. كود التغليف العادي] ---
            if (WasUsedForEvent = false):
                if (Order := CurrentOrder?):
                    if (Order.CurrentStatus = order_status.Packaging):
                        for (i := 1..Order.FoodName.Length):
                            ItemRemover.Remove(InAgent)

                        BoxGranter.GrantItem(InAgent)
                        
                        NewOrder := active_order{
                            TargetApartmentID := Order.TargetApartmentID,
                            FoodName := Order.FoodName,
                            CurrentStatus := order_status.Delivering, 
                            TimeRemaining := TotalTimeForDelivery,
                            IsVIP := Order.IsVIP,
                            FoodIndex := Order.FoodIndex 
                        }
                        set CurrentOrder = option{NewOrder}
                        set CurrentStageName = "توصيل الطلب 🚚"
                        set StepTimeRemaining = TotalTimeForDelivery

                        HUDMessage.SetText(TextToMsg("📦 تم التغليف, توجه لتوصيل الطلب !"))
                        HUDMessage.Show(InPlayer)
                        UpdateUI(InPlayer)
                    else:
                        HUDMessage.SetText(TextToMsg("⚠️ الأكل غير جاهز للتغليف بعد!"))
                        HUDMessage.Show(InPlayer)

            UpdateButtonsState()

