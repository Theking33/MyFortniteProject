    LoadPlayerData(InPlayer : player):void=
        # نحاول قراءة البيانات من المخزن الدائم
        if (LoadedStats := SavedPlayerData[InPlayer]):
            # 1. إذا وجدنا بيانات (لاعب قديم) - الكود الأصلي الخاص بك
            set PlayerMoney = LoadedStats.Money
            set PlayerLevel = LoadedStats.Level
            set DayCount = LoadedStats.CurrentDay
            set CompletedOrders = LoadedStats.TotalOrders
            set DebtElectricity = LoadedStats.SavedDebtElectricity
            set DebtRent = LoadedStats.SavedDebtRent
            set Reputation = LoadedStats.SavedReputation
            set TotalDeliveries = LoadedStats.SavedTotalDeliveries
            
            
            # تحميل التطويرات (الكود الأصلي)
            set PrepLevel = LoadedStats.SavedPrepLevel
            set CookLevel = LoadedStats.SavedCookLevel
            set PackLevel = LoadedStats.SavedPackLevel
            set HasRadarUpgrade = LoadedStats.HasRadarUpgrade
            set IsVIPPurchased = LoadedStats.IsVIPPurchased
            set BonusDeliveryTime = LoadedStats.SavedBonusTime
            set PlayerHasFuel = LoadedStats.HasFuel
            set NextLevelThreshold = LoadedStats.SavedLevelThreshold

            if (PlayerHasFuel > 0):
                ItemGranterFuel.GrantItem(InPlayer)
                Print("⛽ تم منح اللاعب الوقود المحفوظ في حقيبته")


            # --- [ الإضافات الجديدة للتحميل ] ---

            # 1. تحميل المخزون لكل صنف طعام
            for (Index -> StockValue : LoadedStats.InventoryStocks):
                if (Item := FoodMenu[Index]):
                    set Item.Stock = StockValue
            
            # 2. تحميل حالات الشراء للمركبات والسرعة في الـ Maps
            
            if (set RadarUpgradeMap[InPlayer] = LoadedStats.HasRadarUpgrade) {}
            if (set VIPPurchasedMap[InPlayer] = LoadedStats.IsVIPPurchased) {}

            UpdateButtonsState()

            Print("📥 تم استعادة بياناتك، مخزنك، ومركباتك بنجاح!")

        else:
            # 2. إذا لم نجد بيانات (لاعب جديد لأول مرة)
            # نقوم بتعريف البيانات الابتدائية ونضع فيها ID السيارة المجانية (مثلاً 0)
            InitialStats := player_stats{
                Money := 120,             # المبلغ الابتدائي
                Level := 1,               # الليفل الابتدائي
                SavedOwnedCars := array{0}      # السيارة المجانية (ID: 0)
            } 
            
            # تحديث المتغيرات الحية في اللعبة من البيانات الابتدائية
            set PlayerMoney = InitialStats.Money
            set PlayerLevel = InitialStats.Level
            set DayCount = InitialStats.CurrentDay
            
            # نحفظ البيانات في السيرفر فوراً
            if (set SavedPlayerData[InPlayer] = InitialStats):
                Print("🆕 أهلاً بك! تم منحك سيارة مجانية و 120$")

        # تحديث الواجهة لتظهر الفلوس والسيارة المملوكة
        UpdateUI(InPlayer)


    SavePlayerData(InPlayer : player):void=
        # 1. تحويل مخزون الطعام لقائمة أرقام
        var TempStocks : []int = array{}
        for (Item : FoodMenu):
            set TempStocks += array{Item.Stock}
    
        # 2. جلب الحالات الخاصة من الخرائط أو تعيين false
        IsSpeedActive := SpeedUpgradeMap[InPlayer] or false
        IsScooterActive := ScooterUnlockedMap[InPlayer] or false
        IsVehicleActive := VehicleUnlockedMap[InPlayer] or false
