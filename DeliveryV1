    # دالة "تنتظر" الضغطة لكل زر بشكل مستقل
    AwaitButtonPress(Button : button_device, Index : int)<suspends> : void =
        loop:
            # --- [1. فحص وتحديث حالة الزر] ---
            if (Order := CurrentOrder?):
                var IsNeeded : logic = false
                if (SelectedFood := FoodMenu[Index]):
                    for (ReqName : Order.FoodName):
                        if (ReqName = SelectedFood.FoodName):
                            set IsNeeded = true
                
                # تفعيل الزر فقط في مرحلة التحضير وإذا كان الصنف مطلوباً
                if (IsNeeded = true and Order.CurrentStatus = order_status.Preparing):
                    Button.Enable()
                else:
                    Button.Disable() 

            # --- [2. انتظار ضغطة اللاعب] ---
            Agent := Button.InteractedWithEvent.Await()
            
            if (InPlayer := player[Agent], SelectedFood := FoodMenu[Index]):
                if (SelectedFood.Stock > 0):
                    var WasUsedForEvent : logic = false

                   # --- [3. منطق الحدث الخاص - المطور ] ---
                    if (IsEventActive?):
                        for (Key -> Req : ActiveEventReqs):
                            if (WasUsedForEvent = false and Req.FoodName = SelectedFood.FoodName and Req.CurrentBatchCount < Req.RequiredAmount):
                                if (set FoodMenu[Index].Stock = SelectedFood.Stock - 1):
                                    # 🟢 التحديث السحري للعداد هنا:
                                    NewReq := event_requirement{
                                        FoodName := Req.FoodName,
                                        RequiredAmount := Req.RequiredAmount,
                                        CurrentBatchCount := Req.CurrentBatchCount + 1, # زيادة العداد
                                        IsCookedCount := Req.IsCookedCount,
                                        IsFullyPacked := Req.IsFullyPacked
                                    }
                                    
                                    if (set ActiveEventReqs[Key] = NewReq):
                                        set WasUsedForEvent = true
                                        SelectedFood.ItemGranter.GrantItem(Agent)
                                        
                                        # فحص هل اكتملت المكونات للانتقال للمرحلة التالية
                                        CheckEventStageTransition(InPlayer) 
                                        
                                        UpdateUI(InPlayer) # تحديث الشاشة فوراً (0/5 تصبح 1/5)
                                        UpdateButtonsState()
                                        SavePlayerData(InPlayer)

                    # --- [4. منطق الطلب العادي - الحماية من التكرار والحذف] ---
                    if (WasUsedForEvent = false):
                        if (Order := CurrentOrder?):
                            
                            # الحالة الأولى: مرحلة التحضير (Preparing)
                            if (Order.CurrentStatus = order_status.Preparing):
                                AlreadyPicked := if (Val := ItemsPickedInCurrentOrder[SelectedFood.FoodName]) then Val else false
                                
                                if (AlreadyPicked = false):
                                    if (set FoodMenu[Index].Stock = SelectedFood.Stock - 1):
                                        if (SelectedFood.NeedsCooking = false):
                                            # منح السلطة/البارد لأول مرة
                                            SelectedFood.CookedGranter.GrantItem(Agent)
                                            
                                        else:
                                            # منح البيتزا النيئة
                                            SelectedFood.ItemGranter.GrantItem(Agent)

                                        SavePlayerData(InPlayer)

                                        if (set ItemsPickedInCurrentOrder[SelectedFood.FoodName] = true):
                                            Print("تم سحب {SelectedFood.FoodName} بنجاح")

                                        set PreparedItemsCount += 1
                                        HUDMessage.SetText(TextToMsg("✅ تم تجهيز {SelectedFood.FoodName} ({PreparedItemsCount}/{Order.FoodName.Length})"))
                                        HUDMessage.Show(Agent)

                                        # التحقق من الانتقال للمرحلة التالية
                                        if (PreparedItemsCount >= Order.FoodName.Length):
                                            var NeedsAnyCooking : logic = false
                                            for (OrderedFoodName : Order.FoodName):
                                                for (MenuItem : FoodMenu):
                                                    if (MenuItem.FoodName = OrderedFoodName and MenuItem.NeedsCooking = true):
                                                        set NeedsAnyCooking = true

                                            var NextStatus : order_status = order_status.Cooking
                                            if (NeedsAnyCooking = false):
                                                set NextStatus = order_status.Packaging

                                            NewOrder := active_order:
                                                TargetApartmentID := Order.TargetApartmentID
                                                FoodName := Order.FoodName
                                                FoodIndex := Order.FoodIndex
                                                CurrentStatus := NextStatus 
                                                TimeRemaining := Order.TimeRemaining
                                                IsVIP := Order.IsVIP

                                            set CurrentOrder = option{NewOrder}
                                            set PreparedItemsCount = 0 
                                            UpdateUI(InPlayer)
                                            UpdateButtonsState()
                                            SavePlayerData(InPlayer)

                            # الحالة الثانية: مرحلة الطبخ (Cooking) - هنا يتم منع حذف السلطة
                           else if (Order.CurrentStatus = order_status.Cooking):

                            # بمجرد الضغط، نسلم كل شيء وننقل الحالة لـ Packaging لمنع الضغط مرة أخرى
                            for (FoodNameInOrder : Order.FoodName):
                                for (MenuItem : FoodMenu):
                                    if (MenuItem.FoodName = FoodNameInOrder):
                                        if (MenuItem.NeedsCooking = true):
                                            MenuItem.CookedGranter.GrantItem(Agent)
                                        else:
                                            MenuItem.CookedGranter.GrantItem(Agent)
                            
                            # تحويل الحالة فوراً لتغليف
                            NewOrder := active_order{
                                TargetApartmentID := Order.TargetApartmentID,
                                FoodName := Order.FoodName,
                                CurrentStatus := order_status.Packaging, # انتقل للتغليف فوراً
                                TimeRemaining := Order.TimeRemaining,
                                IsVIP := Order.IsVIP,
                                FoodIndex := Order.FoodIndex
                            }
                            set CurrentOrder = option{NewOrder}
                            UpdateButtonsState() # سيقوم هذا بتعطيل زر الطبخ فوراً

                else:
                    HUDMessage.SetText(TextToMsg("⚠️ المخزون نفد!"))
                    HUDMessage.Show(Agent)

    CheckEventStageTransition(InPlayer : player):void=
        var AllGathered : logic = true
        var AllCooked : logic = true

        for (Req : ActiveEventReqs):
            if (Req.CurrentBatchCount < Req.RequiredAmount):
                 set AllGathered = false
            if (Req.IsCookedCount < Req.RequiredAmount):
                 set AllCooked = false

        if (AllCooked?):
            set CurrentStageName = "مرحلة التغليف 📦"
        else if (AllGathered?):
            set CurrentStageName = "مرحلة الطبخ 🔥"
        else:
            set CurrentStageName = "مرحلة التحضير 👨‍🍳"

