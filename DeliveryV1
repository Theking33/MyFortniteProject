    StartMasterTimer(InPlayer : player)<suspends>:void=
        if (IsTimerRunning = true): 
            return 
        set IsTimerRunning = true
        
        loop:
            Sleep(1.0)
            if (Order := CurrentOrder?):
                set StepTimeRemaining -= 1.0
                
                # --- عندما يصل الوقت للصفر ---
                if (StepTimeRemaining <= 0.0):
                    if (Stats := SavedPlayerData[InPlayer]):
                        
                        # 1️⃣ الحالة الأولى: إذا كان في مرحلة التوصيل (إلغاء فوري)
                        if (CurrentStageName = "توصيل الطلب 🚚"):
                            # إلغاء الطلب وحذف الصندوق
                            set CurrentOrder = false 
                            ItemRemover.Remove(InPlayer) 
                            
                            # عقوبة التوصيل (خصم أكبر لأن الزبون انتظر طويلاً)
                            PenaltyMoney := 15
                            PenaltyRep := 5.0
                            set PlayerMoney -= PenaltyMoney # يسمح ان يصبح المال بالسالب 
                            
        
                            SavePlayerData(InPlayer)

                            HUDMessage.SetText(TextToMsg("❌ انتهى وقت التوصيل! ألغى الزبون الطلب."))
                            HUDMessage.Show(InPlayer)
                            
                            set CurrentStageName = "انتظار طلب جديد..."
                            set IsTimerRunning = false
                            UpdateUI(InPlayer)
                            UpdateButtonsState()
                            break # إنهاء العداد تماماً

                        # 2️⃣ الحالة الثانية: إذا كان في التحضير أو الطبخ (يعطيه وقت إضافي)
                        # 2️⃣ الحالة الثانية: إذا كان في التحضير أو الطبخ (يعطيه وقت إضافي)
                        else:
                            PenaltyMoney := 5
                            set PlayerMoney -= PenaltyMoney
                            
                            # --- أضف الحفظ هنا أيضاً ---
                            SavePlayerData(InPlayer) 
                            # -------------------------

                            set StepTimeRemaining = 30.0 
                            HUDMessage.SetText(TextToMsg("⚠️ أسرع في التحضير! خصم 5$"))
                            HUDMessage.Show(InPlayer)
                            UpdateUI(InPlayer)
                
                UpdateUI(InPlayer)
            else:
                set IsTimerRunning = false
                set CurrentStageName = "انتظار طلب جديد..."
                set StepTimeRemaining = 0.0
                UpdateUI(InPlayer)
                break
                
   

        

    
    # دالة ذكية لتغيير المال (سواء خصم أو إضافة) مع المزامنة
    ChangeMoney(InAgent: agent, Amount: int) : logic =
        if (InPlayer := player[InAgent]):
            # 1. نحسب القيمة الجديدة بناءً على المتغير الحي في الكود
            NewMoney := PlayerMoney + Amount
            
            # 2. نتحقق إذا كان المبلغ الجديد مسموحاً به
            if (NewMoney >= 0):
                # تحديث المتغير الحي (ضروري جداً قبل استدعاء الحفظ)
                set PlayerMoney = NewMoney
                
                # 3. استدعاء الحفظ الشامل (سيأخذ قيمة PlayerMoney الجديدة ويحفظها)
                SavePlayerData(InPlayer)
                
                # 4. تحديث الواجهة فوراً
                UpdateUI(InPlayer)
                
                return true
        return false



        # دالة خاصة لشراء الاغراض ب 10
    HandlePayment(InPlayer : agent):void=
        # 1. نتحقق أولاً إذا كان مع اللاعب المال الكافي (10$)
        if (PlayerMoney >= 10):
            # 2. ننفذ الخصم والحفظ (نستدعي الدالة كأمر مستقل بدون ?)
            void(ChangeMoney(InPlayer, -10))
            
            # لا نحتاج لـ set PlayerMoney -= 10 هنا لأن ChangeMoney تفعل ذلك بداخلها
            
            # 3. تفعيل المحطة
            spawn { ActivateStationWithDelay() }
            
            Print("⛽ تم الخصم بنجاح! جاري تشغيل المحطة...")
        else:
            # 4. إذا كان المال غير كافٍ
            Print("❌ رصيدك غير كافٍ")


    # دالة خاصة لشراء الأغراض بـ 20$
    HandleItemPurchase(InAgent : agent):void=
        if (InPlayer := player[InAgent]):
            # 1. التحقق من السعر
            if (PlayerMoney >= 20):
                # 2. تنفيذ الخصم والحفظ والتحديث (تأكد أن ChangeMoney تستدعي SavePlayerData)
                void(ChangeMoney(InPlayer, -20))
                
                # 3. منح الغرض فوراً
                ItemGranterFuel.GrantItem(InPlayer)

                # 4. تحديث حالة الوقود برمجياً عشان تنحفظ
                # هنا نفترض أن عندك متغير عام اسمه PlayerHasFuel
                set PlayerHasFuel = 1 
                
                # 5. استدعاء الحفظ يدوياً لضمان تسجيل أن معه وقود
                SavePlayerData(InPlayer)
                    
                Print("🛍️ تم شراء الوقود وحفظ ملكيته!")
            else:
                Print("❌ لا تملك 20$ لشراء هذا الغرض")



# دالة مساعدة لضمان استيقاظ المحطة
    ActivateStationWithDelay()<suspends>:void=
        MyStation.Disable() # نطفئها أولاً للتأكد
        Sleep(0.1)          # ننتظر جزء بسيط جداً من الثانية (هذا هو الحل!)
        MyStation.Enable()  # نشغلها الآن، المحرك سيشعر بالتغيير حتماً
        
        # تأكيد إضافي إذا كانت السيارة بالداخل
        if (MyStation.IsAnyVehicleInside[]):
            Print("🚗 السيارة مكتشفة! الوقود يعمل الآن.")
                    
    # دالة التعطيل عند الخروج
    ResetStation(Vehicle : fort_vehicle):void=
        if (not IsCountingDown?): # نضمن أنه لا يوجد عداد يعمل حالياً
            set IsCountingDown = true
            spawn{ WaitAndDisable() }
            Print("⚠️ بدأت مهلة الـ 10 ثواني...")

    WaitAndDisable()<suspends>:void=
        Sleep(10.0) 
        set IsCountingDown = false # انتهى العداد
        
        # التحقق النهائي والأهم
        if (not MyStation.IsAnyVehicleInside[]):
            MyStation.Disable()
            Print("🔒 تم الإغلاق.")
        else:
            Print("✅ تم إلغاء الإغلاق لوجود مركبة.")


        
       
    

