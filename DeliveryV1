   # دالة دفع الكهرباء المصححة
    PayElectricityBill(WM : widget_message):void=
        InPlayer := WM.Player
        
        # قراءة القيم من الذاكرة لضمان الدقة
        CurrentElecDebt := DebtElectricity
        CurrentMoney := PlayerMoney

        if (CurrentElecDebt > 0):
            var AmountToDeduct : int = 0
            
            # --- منطق الدفع الجزئي ---
            if (CurrentMoney >= CurrentElecDebt):
                # إذا معك فلوس كافية، ادفع كامل فاتورة الكهرباء
                set AmountToDeduct = CurrentElecDebt
            else:
                # إذا معك أقل، ادفع كل ما تملك للكهرباء
                set AmountToDeduct = CurrentMoney

            if (AmountToDeduct > 0):
                # الخصم الحسابي الصريح (طرح فقط)
                set PlayerMoney = CurrentMoney - AmountToDeduct
                set DebtElectricity = CurrentElecDebt - AmountToDeduct
                
                Print("الكهرباء: خصم {AmountToDeduct}، المتبقي: {DebtElectricity}")

                SavePlayerData(InPlayer)
                
                HUDMessage.SetText(TextToMsg("⚡ تم دفع {AmountToDeduct}$ من فاتورة الكهرباء"))
                HUDMessage.Show(InPlayer)
            else:
                HUDMessage.SetText(TextToMsg("❌ لا تملك مالاً كافياً للكهرباء"))
                HUDMessage.Show(InPlayer)
        else:
            HUDMessage.SetText(TextToMsg("فاتورة الكهرباء مدفوعة ✅"))
            HUDMessage.Show(InPlayer)

        # تحديث الواجهة وإغلاق المنيو
        CloseAllUI(WM)
        UpdateUI(InPlayer)

        
    # دالة دفع الإيجار المصححة
    PayRentBill(WM : widget_message):void=
            InPlayer := WM.Player
            
            # قراءة القيم الحقيقية من الذاكرة الآن
            CurrentDebt := DebtRent
            CurrentMoney := PlayerMoney

            if (CurrentDebt > 0):
                var AmountToDeduct : int = 0
                
                # --- منطق الدفع الجزئي ---
                if (CurrentMoney >= CurrentDebt):
                    # إذا معك فلوس كافية، ادفع الدين كامل
                    set AmountToDeduct = CurrentDebt
                else:
                    # إذا معك أقل، ادفع كل اللي في جيبك
                    set AmountToDeduct = CurrentMoney

                if (AmountToDeduct > 0):
                    # الخصم الحسابي الصريح
                    set PlayerMoney = CurrentMoney - AmountToDeduct
                    set DebtRent = CurrentDebt - AmountToDeduct
                    SavePlayerData(InPlayer)
                    
                    # رسالة HUD توضح المبلغ المخصوم فعلياً
                    HUDMessage.SetText(TextToMsg("✅ تم دفع {AmountToDeduct}$ من الإيجار"))
                    HUDMessage.Show(InPlayer)
                    
                    Print("تمت العملية: خصم {AmountToDeduct}، المتبقي من الدين: {DebtRent}")
                else:
                    HUDMessage.SetText(TextToMsg("❌ محفظتك فارغة تماماً!"))
                    HUDMessage.Show(InPlayer)
            else:
                HUDMessage.SetText(TextToMsg("مدفوع بالكامل ✅"))
                HUDMessage.Show(InPlayer)

            # تحديث وإغلاق
            CloseAllUI(WM)
            UpdateUI(InPlayer)

