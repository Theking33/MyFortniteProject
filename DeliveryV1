    FinishOrder(InAgent : agent, EnteredAptID : int):void=
        Print("🔔 محاولة تسليم للمنزل: {EnteredAptID}")
        
        if (InPlayer := player[InAgent]):
            # --- [1. مسار الأحداث الكبرى - Special Event Path] ---
            if (IsEventActive?):
                var AllReadyForEvent : logic = true
                
                # فحص حالة الأصناف: هل كل صنف مر بمساره الصحيح؟
                for (Req : ActiveEventReqs):
                    # نتحقق من نوع الصنف في المنيو (بارد أم ساخن)
                    var ThisItemNeedsCooking : logic = false
                    for (Food : FoodMenu):
                        if (Food.FoodName = Req.FoodName and Food.NeedsCooking = true):
                            set ThisItemNeedsCooking = true
                    
                    # المنطق: 
                    # 1. إذا كان يحتاج طبخ ولسه ما انطبخ -> AllReady = false
                    # 2. إذا لسه ما تغلف (سواء بارد أو ساخن) -> AllReady = false
                    if (ThisItemNeedsCooking? and Req.IsCookedCount < Req.RequiredAmount):
                        set AllReadyForEvent = false
                    
                    if (Req.IsFullyPacked = false):
                        set AllReadyForEvent = false

                # إذا تحقق الشرط النهائي (الكل مطبوخ أو بارد جاهز ومغلف)
                if (AllReadyForEvent?):
                    EventReward := 500 
                    set PlayerMoney += EventReward
                    EventAccolade.Award(InPlayer)
                    
                    set IsEventActive = false
                    set ActiveEventReqs = map{}
                    
                    ItemRemover.Remove(InAgent) 
                    
                    HUDMessage.SetText(TextToMsg("🎊 مبروك! اكتمل الحدث الكبير واستلمت مكافأة: {EventReward}$"))
                    HUDMessage.Show(InPlayer)
                    
                    UpdateUI(InPlayer)
                    UpdateButtonsState()
                    SavePlayerData(InPlayer)
                    return 
                else:
