# 2. تعريف المنتجات (انتبه لإغلاق الموديول هنا)
MoneyProducts := module:
    using {MoneyProductsI}
    island_money_products<public> := class<abstract><castable>(entitlement){}

    SmallMoney<public> := class<concrete>(island_money_products):
        var Name<override>:message = SmallPack.Name
        var Description<override>:message = SmallPack.ShortDescription
        var ShortDescription<override>:message = SmallPack.ShortDescription
        # استخدام المسار الكامل لتجنب الخطأ السابق
        var Icon<override>:texture = Delivery.MoneyIcon
        Consumable<override>: logic = true
        MaxCount<override>: int = 99


    MediumMoney<public> := class<concrete>(island_money_products):
        var Name<override>:message = MediumPack.Name
        var Description<override>:message = MediumPack.FullDescription
        var ShortDescription<override>:message = MediumPack.ShortDescription
        # استخدام المسار الكامل لتجنب الخطأ السابق
        var Icon<override>:texture = Delivery.MoneyIcon
        Consumable<override>: logic = true
        MaxCount<override>: int = 99


    LargeMoney<public> := class<concrete>(island_money_products):
        var Name<override>:message = LargePack.Name
        var Description<override>:message = LargePack.FullDescription
        var ShortDescription<override>:message = LargePack.ShortDescription
        var Icon<override>:texture = Delivery.MoneyIcon
        Consumable<override>: logic = true
        MaxCount<override>: int = 99

