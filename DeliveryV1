    ConfirmPurchase(WM : widget_message):void=
        InPlayer := WM.Player
        var Price : int = 0
        var ArabicName : string = "" # أضفنا هذا لعرض اسم بالعربي في الرسالة

        # --- 1. حساب السعر وتحديد الاسم العربي ---
        if (CurrentBuyingType = "Prep"):
            set Price = BasePrice + (PrepLevel * 200)
            set ArabicName = "طاولة التحضير"
        else if (CurrentBuyingType = "Cook"):
            set Price = BasePrice + (CookLevel * 200)
            set ArabicName = "الفرن"
        else if (CurrentBuyingType = "Pack"):
            set Price = BasePrice + (PackLevel * 200)
            set ArabicName = "الحقيبة"
        else if (CurrentBuyingType = "Warehouse"):
            set Price = 500 + (WarehouseLevel * 300)
            set ArabicName = "المخزن"
        else if (CurrentBuyingType = "VIP"):
            set Price = 2000 
            set ArabicName = "VIP"
        

        # --- 2. التحقق من المال والتنفيذ ---
        if (PlayerMoney >= Price):
            set PlayerMoney -= Price
            
            # تنفيذ التطوير
            if (CurrentBuyingType = "Prep"):
                set PrepLevel += 1
            else if (CurrentBuyingType = "Cook"):
                set CookLevel += 1
            else if (CurrentBuyingType = "Pack"):
                set PackLevel += 1
            else if (CurrentBuyingType = "Warehouse"):
                set WarehouseLevel += 1
                set GlobalMaxCapacity += 50
           
                

            # تحديث الرسالة بالاسم العربي
            set ShopStatusMessage = "✅ تم تطوير {ArabicName} بنجاح!"
            set StatusColor = NamedColors.Green
            
            SavePlayerData(InPlayer)
            
        else:
            # رسالة الفشل
            set ShopStatusMessage = "❌ ليس لديك مال كافٍ لتطوير {ArabicName}!"
            set StatusColor = NamedColors.Red
        
        # --- 3. إغلاق النافذة وتحديث المتجر ---
        CloseConfirmUI(WM.Player)
        ShowUpgradeMenu(WM.Player) # <--- هذا السطر هو اللي بيخلي دالتك اللي فوق "تصحى" وتشوف الرسالة


