    GetDistrictName(HouseNumber : int) : string =
        # الشقق 1-10 (Index 0)، 11-20 (Index 1)، 21-30 (Index 2)
        var DistrictIndex : int = 0
        
        if (HouseNumber > 20 and HouseNumber <= 40):
            set DistrictIndex = 1
        else if (HouseNumber > 40 and HouseNumber <= 60):
            set DistrictIndex = 2
        else if (HouseNumber > 60 and HouseNumber <= 80):
            set DistrictIndex = 3
            
        # التأكد أن المصفوفة تحتوي على هذا العنصر لتجنب الأخطاء
        if (Name := DistrictNames[DistrictIndex]):
            return Name
            
        return "منطقة خارجية"

