                    HUDMessage.SetText(TextToMsg("⚠️ الطلبية غير مكتملة! تأكد من طبخ الساخن وتغليف كل الأصناف."))
                    HUDMessage.Show(InPlayer)

            # --- [2. مسار الطلب العادي - Regular Order Path] ---
            if (Order := CurrentOrder?):
