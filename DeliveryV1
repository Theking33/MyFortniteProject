    OnConfirmAccept(wm : widget_message) : void =
        InPlayer := wm.Player
        if (PlayerUI := GetPlayerUI[InPlayer]):
            # 1. الحذف هو الحل الوحيد لإخفاء الماوس تماماً
            if (ActualCanvas := ConfirmCanvas?):
                PlayerUI.RemoveWidget(ActualCanvas)
                set ConfirmCanvas = false # تفريغ المتغير مهم جداً

            # 2. تنفيذ العمليات (كودك كما هو)
            if (PendingIndex = 99): # تطوير التحضير
                PriceToPay := BasePrice + (PrepLevel * 200)
                if (PlayerMoney >= PriceToPay):
                    set PlayerMoney -= PriceToPay
                    set PrepLevel += 1
                    PurchaseSound.Play(InPlayer)
                else:
                    Print("المال غير كافٍ")

            else if (PendingIndex = 100): # تطوير الطبخ
                PriceToPay := BasePrice + (CookLevel * 200)
                if (PlayerMoney >= PriceToPay):
                    set PlayerMoney -= PriceToPay
                    set CookLevel += 1
                    PurchaseSound.Play(InPlayer)

            else if (PendingIndex = 101): # تطوير الحقيبة
                PriceToPay := BasePrice + (PackLevel * 200)
                if (PlayerMoney >= PriceToPay):
                    set PlayerMoney -= PriceToPay
                    set PackLevel += 1
                    set ShopStatusMessage = "✅ تم تطوير الحقيبة للمستوى {PackLevel}"
                    PurchaseSound.Play(InPlayer)
                else:
                    set ShopStatusMessage = "❌ مال غير كافٍ للحقيبة!"

            else if (PendingIndex = 102): # تطوير المخزن
                PriceToPay := BasePrice + (WarehouseLevel * 300)
                if (PlayerMoney >= PriceToPay):
                    set PlayerMoney -= PriceToPay
                    set WarehouseLevel += 1
                    set GlobalMaxCapacity += 50
                    set ShopStatusMessage = "✅ تم تطوير المخزن للمستوى {WarehouseLevel}"
                    PurchaseSound.Play(InPlayer)
                else:
                    set ShopStatusMessage = "❌ مال غير كافٍ للمخزن!"

            
            else: 
                ProcessPurchase(InPlayer, PendingIndex)

            # 3. التحديث النهائي
            SavePlayerData(InPlayer)
            CloseAllUI(wm)
           
   
    
            # 4. إعادة بناء الواجهة بالأرقام الجديدة فوراً
