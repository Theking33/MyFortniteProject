    # دالة لتحديث حالة الأزرار بناءً على المستوى
    UpdateButtonsState():void=
        # 1. إغلاق أزرار المنيو كقاعدة عامة
        for (FoodItem : FoodMenu):
            FoodItem.Button.Disable()

        # 2. التحكم في أزرار المنيو (للحدث أو الطلب العادي)
        if (IsEventActive?):
            for (Key -> Req : ActiveEventReqs):
                for (FoodItem : FoodMenu):
                    if (FoodItem.FoodName = Req.FoodName):
                        if (Req.CurrentBatchCount < Req.RequiredAmount):
                            FoodItem.Button.Enable()

        # --- التعديل هنا لدعم حالة الاحتراق (Burnt) ---
        else if (Order := CurrentOrder?):
            # إذا كانت الحالة "تحضير" أو "محروق"، نفتح أزرار المنيو ليأخذ اللاعب أغراض
            if (Order.CurrentStatus = order_status.Preparing):
                for (FoodItem : FoodMenu):
                    if (PlayerLevel >= FoodItem.RequiredLevel):
                        for (OrderedFoodName : Order.FoodName):
                            if (FoodItem.FoodName = OrderedFoodName):
                                FoodItem.Button.Enable()

        # 3. تفعيل الفرن والتغليف
        var ShouldOvenBeOpen : logic = false
        var ShouldPackagingBeOpen : logic = false
        var ShouldEventDeliveryBeOpen : logic = false 

        if (IsEventActive?):
            var AllEventItemsPacked : logic = true 
            for (Key -> Req : ActiveEventReqs):
                if (Req.CurrentBatchCount >= Req.RequiredAmount and Req.IsCookedCount < Req.CurrentBatchCount):
                    set ShouldOvenBeOpen = true
                
                if (Req.IsCookedCount >= Req.RequiredAmount and Req.IsFullyPacked = false):
                    set ShouldPackagingBeOpen = true
                
                if (Req.IsFullyPacked = false):
                    set AllEventItemsPacked = false
            
            if (AllEventItemsPacked?):
                set ShouldEventDeliveryBeOpen = true

        else if (Order := CurrentOrder?):
            # منطق الطلب العادي
            if (Order.CurrentStatus = order_status.Cooking):
                var OrderNeedsCooking : logic = false
                for (OrderedFoodName : Order.FoodName):
                    for (MenuItem : FoodMenu):
                        if (MenuItem.FoodName = OrderedFoodName and MenuItem.NeedsCooking = true):
                            set OrderNeedsCooking = true
                
                if (OrderNeedsCooking = true):
                    set ShouldOvenBeOpen = true

            # التعديل: التغليف يفتح فقط إذا كانت الحالة Packaging
            else if (Order.CurrentStatus = order_status.Packaging):
                set ShouldPackagingBeOpen = true

        # 4. تطبيق الحالة النهائية للأجهزة
        if (ShouldOvenBeOpen?):
            CookingButton.Enable()
        else:
            CookingButton.Disable()

        if (ShouldPackagingBeOpen?):
            PackagingButton.Enable()
        else:
            PackagingButton.Disable()

        # 6. تفعيل أزرار الشقق للطلبات العادية
        if (not IsEventActive?):
            if (Order := CurrentOrder?):
                for (Apt : Apartments + VIPApartments):
                    if (Order.CurrentStatus = order_status.Delivering and Apt.ApartmentID = Order.TargetApartmentID):
                        Apt.CondButton.Enable()
                    else:
                        Apt.CondButton.Disable()
            else:
                for (Apt : Apartments + VIPApartments):
                    Apt.CondButton.Disable()

   

