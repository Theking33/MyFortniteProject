    # عند الضغط على زر الشراء (مثلاً لبرجر - Index 0)
    BuyStock(InPlayer : player, Index : int) : void =
        CurrentTotal := CalculateTotalStock()
        BatchSize := 10 # الكمية التي تضاف في كل شحنة
        
        if (CurrentTotal + BatchSize <= GlobalMaxCapacity):
            if (PlayerMoney >= 50): # سعر الشحنة
                set PlayerMoney -= 50
                if (set FoodMenu[Index].Stock += BatchSize):
                    Print("✅ تم الشراء. المخزن: {CurrentTotal + BatchSize}/{GlobalMaxCapacity}")
                    SavePlayerData(InPlayer) # حفظ التغيير
                    UpdateUI(InPlayer)
            else:
                Print("❌ فلوسك ما تكفي!")
        else:
            Print("⚠️ المخزن ممتلئ! السعة {GlobalMaxCapacity}")

    
