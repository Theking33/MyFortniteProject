    # --- دالة بدء عملية الطبخ (عند ضغط زر الفرن) ---
    OnStartCooking(InAgent : agent) : void =
        if (InPlayer := player[InAgent]):
            var MaxElectricDebt : int = 40 + (PlayerLevel * 60)
            
            Print("الزر انضغط!") # عشان تتأكد إن الربط في UEFN صح
            
            
            # 1. فحص ديون الكهرباء
            if (DebtElectricity >= MaxElectricDebt):
                HUDMessage.SetText(TextToMsg("⚠️ الكهرباء مقطوعة! ادفع فواتيرك من الكمبيوتر أولاً"))
                HUDMessage.Show(InPlayer)
                return 

            var WasUsedForEvent : logic = false

            # 2. فحص إذا كان الطبخ لحدث نشط
            if (IsEventActive?):
                for (Key -> Req : ActiveEventReqs):
                    if (Req.IsCookedCount < Req.CurrentBatchCount):
                        # نتحقق من المنيو: هل هذا الصنف يحتاج طبخ؟
                        var FoundNeedsCooking : logic = false
                        for (Food : FoodMenu):
                            if (Food.FoodName = Req.FoodName and Food.NeedsCooking = true):
                                set FoundNeedsCooking = true

                        if (FoundNeedsCooking?):
                            # 🔥 صنف ساخن (بيتزا): شغل الفرن
                            spawn{ StartCookingTimer(InPlayer) }
                        else:
                            # 🥗 صنف بارد (سلطة): اعتبره "مطبوخ" فوراً وانقله للتغليف
                            NewReq := event_requirement{
                                FoodName := Req.FoodName,
                                RequiredAmount := Req.RequiredAmount,
                                CurrentBatchCount := Req.RequiredAmount,
                                IsCookedCount := Req.RequiredAmount, # ننهي مرحلة الفرن فوراً
                                IsFullyPacked := Req.IsFullyPacked
                            }
                            if (set ActiveEventReqs[Key] = NewReq):
                                HUDMessage.SetText(TextToMsg("🥗 {Req.FoodName} جاهزة للتغليف مباشرة!"))
                                HUDMessage.Show(InPlayer)
                                UpdateButtonsState()
                                UpdateUI(InPlayer)
                        return

            # 3. إذا لم يكن للحدث، نتحقق من الطلب العادي
            if (WasUsedForEvent = false):
                if (Order := CurrentOrder?):
                    if (Order.CurrentStatus = order_status.Packaging):
                        HUDMessage.SetText(TextToMsg("📦 الأكل نضج بالفعل، توجه للتغليف!"))
                        HUDMessage.Show(InPlayer)
                    else if (Order.CurrentStatus = order_status.Cooking):
                        spawn{ StartCookingTimer(InPlayer) }
                        Print("بدأ الطبخ للطلب العادي")
                    else:
                        HUDMessage.SetText(TextToMsg("⚠️ جهّز المكونات أولاً من المطبخ!"))
                        HUDMessage.Show(InPlayer)
                else:
                    Print("لا يوجد طلب عادي ولا حدث نشط!")
                    HUDMessage.SetText(TextToMsg("⚠️ لا يوجد طلب للبدء بالطبخ!"))
                    HUDMessage.Show(InPlayer)


    # --- دالة المؤقت والتعامل مع النتائج (استلام أو احتراق) ---
    # --- دالة المؤقت المعدلة للطبخ الجماعي ---
   # --- دالة المؤقت والتعامل مع النتائج (استلام أو احتراق) ---
    # تم التعديل لربط سرعة الطبخ بمستوى CookLevel الخاص باللاعب
    StartCookingTimer(InPlayer : player)<suspends> : void =
        if (Agent := agent[InPlayer]):
            # --- 1. فحص الأصناف الباردة (صمام الأمان) ---
            var NeedsCookingAtAll : logic = false
            if (IsEventActive?):
                for (Req : ActiveEventReqs):
                    for (MenuItem : FoodMenu):
                        if (MenuItem.FoodName = Req.FoodName and MenuItem.NeedsCooking = true):
                            set NeedsCookingAtAll = true
            else if (Order := CurrentOrder?):
                for (FName : Order.FoodName):
                    for (MenuItem : FoodMenu):
                        if (MenuItem.FoodName = FName and MenuItem.NeedsCooking = true):
                            set NeedsCookingAtAll = true

            if (NeedsCookingAtAll = false):
                HUDMessage.SetText(TextToMsg("❄️ هذه الأصناف باردة، توجه للتغليف مباشرة 📦"))
                HUDMessage.Show(InPlayer)
                UpdateOrderToPackaging(InPlayer)
                return 

            # --- 2. التجهيز والحساب ---
            var TotalAmountToRemove : int = 0
            var DisplayFoodName : string = ""
            var SelectedFoodForTime : ?food_item = false 
            var ItemsCurrentlyInOven : []string = array{}
            
            if (IsEventActive?):
                for (Key -> Req : ActiveEventReqs):
                    for (MenuItem : FoodMenu):
                        if (MenuItem.FoodName = Req.FoodName and MenuItem.NeedsCooking = true):
                            if (Req.IsCookedCount < Req.RequiredAmount):
                                if (MenuItem.ItemChecker.HasAllItems[Agent]):
                                    set TotalAmountToRemove += Req.RequiredAmount
                                    if (not SelectedFoodForTime?):
                                         set SelectedFoodForTime = option{MenuItem}
                                    set DisplayFoodName = if (DisplayFoodName = "") then Req.FoodName else DisplayFoodName + " & " + Req.FoodName
            
            else if (Order := CurrentOrder?):
                for (OrderedFoodName : Order.FoodName):
                    for (MenuItem : FoodMenu):
                        if (MenuItem.FoodName = OrderedFoodName and MenuItem.NeedsCooking = true):
                            if (MenuItem.ItemChecker.HasAllItems[Agent]):
                                set TotalAmountToRemove += 1
                                set DisplayFoodName = MenuItem.FoodName
                                set SelectedFoodForTime = option{MenuItem}

            if (TotalAmountToRemove <= 0):
                HUDMessage.SetText(TextToMsg("⚠️ لا تملك المكونات الخام المطلوبة!"))
                HUDMessage.Show(InPlayer)
                return

            # --- 3. بدء عملية الطبخ (سحب المكونات مرة واحدة فقط) ---
            CookingButton.Disable()
            OvenVFX.Enable()
            BoilingSFX.Play()
            HUDMessage.SetText(TextToMsg("🔥 جاري طبخ: {DisplayFoodName}..."))
            HUDMessage.Show(InPlayer)

            if (Order := CurrentOrder?):
                for (OrderedFoodName : Order.FoodName):
                    for (MenuItem : FoodMenu):
