    # دالة معالجة أي تطوير في اللعبة (خيار احترافي)
    ProcessUpgrade(InPlayer: player, ID: int, Name: string, Cost: int) : void =
        if (PlayerMoney >= Cost):
            set PlayerMoney -= Cost
            
            if (ID = 102): # المخزن
                set WarehouseLevel += 1
                set GlobalMaxCapacity += 50
            else if (ID = 104): # الحقيبة
                set PackLevel += 1
            else if (ID = 2): # التحضير
                set PrepLevel += 1
            else if (ID = 3): # الفرن
                set CookLevel += 1
            
            set ShopStatusMessage = "✅ تم تطوير {Name}!"
            set StatusColor = NamedColors.Green
            PurchaseSound.Play(InPlayer)
        else:
            set ShopStatusMessage = "❌ ليس لديك المال الكافي لتطوير  {Name}"
            set StatusColor = NamedColors.Red

        # السطرين هدول هم "السحر" اللي بحدث الشاشة فوراً
        SavePlayerData(InPlayer)
        UpdateUI(InPlayer)
        
        
    
            
                    

    
