    WaitAndCreateOrder(InPlayer : player)<suspends>:void=
        # 1. جلب السمعة من ملف الحفظ (السمعة هي المفتاح هنا)
        CurrentRep := if (Stats := SavedPlayerData[InPlayer]) then Stats.SavedReputation else 0.0

        # 2. تحديد وقت الانتظار بناءً على السمعة
        var MinWait : float = 1.0
        var MaxWait : float = 5.0

        if (CurrentRep < 20.0):
            set MinWait = 10.0
            set MaxWait = 20.0
        else if (CurrentRep < 50.0):
            set MinWait = 5.0
            set MaxWait = 10.0
        else if (CurrentRep < 80.0):
            set MinWait = 2.0
            set MaxWait = 5.0
        else: 
            set MinWait = 0.5
            set MaxWait = 2.0

        # 3. توليد الوقت العشوائي والانتظار
        WaitTime := GetRandomFloat(MinWait, MaxWait)
        
        HUDMessage.SetText(TextToMsg("📡 بانتظار طلب الزبون القادم..."))
        HUDMessage.Show(InPlayer)

        Sleep(WaitTime) # الانتظار الفعلي

        # 4. إنشاء الطلب وتشغيل الصوت
        if (IsShopOpen = true, not CurrentOrder?):
            CreateNewOrder(InPlayer)
            # تأكد من إضافة (InPlayer) هنا لضمان خروج الصوت عنده
            OrderSound.Play(InPlayer) 
            Print("✅ تم إنشاء الطلب بعد انتظار {WaitTime} ثانية")
            
                
